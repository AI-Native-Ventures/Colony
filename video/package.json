    "@remotion/google-fonts": "4.0.522",
    "@remotion/zod-types": "4.0.522",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.522",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
