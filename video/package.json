{
  "name": "colony-video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Hello out/hello.mp4",
    "render:t1": "remotion render src/index.ts T1 out/t1.mp4 --props=jobs/customers.json",
    "render:batch": "node scripts/render-batch.mjs",
    "check": "biome check src && tsc --noEmit",
    "test": "node --test src/launch/*.test.ts src/launch/wide/*.test.ts src/explainers/*.test.ts",
    "render:proof": "remotion render src/index.ts LaunchProof out/launch-proof.mp4 --jpeg-quality=95 --crf=16",
    "render:proof60": "remotion render src/index.ts LaunchProof60 out/launch-proof-60.mp4 --jpeg-quality=95 --crf=16",
    "still:proof": "remotion still src/index.ts LaunchProof out/launch-proof-hero.png --frame=246",
    "render:film": "remotion render src/index.ts LaunchFilm out/launch-film.mp4 --jpeg-quality=95 --crf=16",
    "still:film": "remotion still src/index.ts LaunchFilm out/launch-film-still.png --frame=600",
    "render:beat": "remotion render src/index.ts TeamBeatProof out/team-beat.mp4 --jpeg-quality=95 --crf=16",
    "master:beat": "ffmpeg -hide_banner -loglevel error -y -i out/team-beat.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k out/team-beat-master.mp4",
    "master:film": "ffmpeg -hide_banner -loglevel error -y -i out/launch-film.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k out/launch-film-master.mp4",
    "render:film90": "remotion render src/index.ts Film90 out/film90.mp4 --jpeg-quality=95 --crf=16 --timeout=120000",
    "render:film90:team": "remotion render src/index.ts Film90 out/film90-team.mp4 --frames=747-1625 --jpeg-quality=95 --crf=16 --timeout=120000",
    "master:film90:team": "ffmpeg -hide_banner -loglevel error -y -i out/film90-team.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k out/film90-team-master.mp4",
    "render:film90:yes": "remotion render src/index.ts Film90 out/film90-yes.mp4 --frames=1605-2384 --jpeg-quality=95 --crf=16 --timeout=120000",
    "master:film90:yes": "ffmpeg -hide_banner -loglevel error -y -i out/film90-yes.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k out/film90-yes-master.mp4",
    "master:film90": "ffmpeg -hide_banner -loglevel error -y -i out/film90.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k out/film90-master.mp4",
    "render:film90:intro": "remotion render src/index.ts Film90 out/film90-intro.mp4 --frames=0-1019 --jpeg-quality=95 --crf=16 --timeout=120000",
    "render:film90:close": "remotion render src/index.ts Film90 out/film90-close.mp4 --frames=3210-3569 --jpeg-quality=95 --crf=16 --timeout=120000"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/google-fonts": "4.0.522",
    "@remotion/zod-types": "4.0.522",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.522",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
