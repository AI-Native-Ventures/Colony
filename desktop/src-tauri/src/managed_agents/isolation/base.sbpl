(version 1)
(deny default)
; Apple-maintained loader bootstrap rules for this OS version.
(import "dyld-support.sb")
(allow process-exec process-fork)
(allow file-read-metadata (literal "/var") (literal "/tmp"))
(allow file-read* (literal "/private/var/select/sh"))
(allow signal process-info* (target same-sandbox))
(allow file-read* file-write* (subpath (param "WORKSPACE")))
(allow file-read-metadata (path-ancestors (param "WORKSPACE")))
(allow file-read*
  (subpath "/System/Library") (subpath "/usr/lib")
  (subpath "/usr/share") (subpath "/usr/bin") (subpath "/bin")
  (literal "/private/etc/ssl/openssl.cnf") (literal "/private/etc/ssl/cert.pem")
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read
  (sysctl-name "hw.ncpu") (sysctl-name "hw.activecpu")
  (sysctl-name "hw.logicalcpu") (sysctl-name "hw.logicalcpu_max")
  (sysctl-name "hw.physicalcpu") (sysctl-name "hw.physicalcpu_max")
  (sysctl-name "hw.pagesize") (sysctl-name "hw.pagesize_compat") (sysctl-name "hw.memsize")
  (sysctl-name "hw.cputype") (sysctl-name "hw.cpufamily")
  (sysctl-name "kern.osrelease") (sysctl-name "kern.osversion")
  (sysctl-name "kern.ostype") (sysctl-name "kern.argmax")
  (sysctl-name "kern.maxfilesperproc") (sysctl-name "kern.usrstack64"))
