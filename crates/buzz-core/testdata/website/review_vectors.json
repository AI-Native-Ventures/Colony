        {"op": "record_revision"},
        {"op": "record_qa"},
        {"op": "mark_ready"},
        {"op": "record_revision", "expect": "revision_while_under_review"}
      ]
    },
    {
      "name": "revision_after_approval",
      "steps": [
        {"op": "begin_work"},
        {"op": "record_revision"},
        {"op": "record_qa"},
        {"op": "mark_ready"},
        {"op": "decide", "kind": "approve", "actor": "owner", "expect": "applied"},
        {"op": "record_revision", "expect": "revision_after_approval"}
      ]
    },
