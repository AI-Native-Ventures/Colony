{
  "schema": "colony.website-review-vectors/1",
  "cases": [
    {
      "name": "happy_path",
      "steps": [
        {"op": "begin_work"},
        {"op": "record_revision"},
        {"op": "record_qa"},
        {"op": "mark_ready"},
        {"op": "expect_status", "status": "readyForReview"},
        {"op": "decide", "kind": "approve", "actor": "owner", "expect": "applied"},
        {"op": "expect_status", "status": "approved"},
        {"op": "expect_active_approval", "activeApproval": true},
        {"op": "expect_decisions", "count": 1},
        {"op": "expect_current_revision", "revision": 1},
        {"op": "attach_evidence"},
        {"op": "record_handover", "acceptedBy": "owner"},
        {"op": "expect_status", "status": "handedOver"},
        {"op": "expect_handover", "handover": true},
        {"op": "expect_handover_history", "count": 0},
        {"op": "check_assets"},
        {"op": "parse"}
      ]
    },
    {
      "name": "parse_draft",
      "steps": [
        {"op": "parse"}
      ]
    },
    {
      "name": "revision_from_draft",
      "steps": [
        {"op": "record_revision", "expect": "invalid_transition"}
      ]
    },
    {
      "name": "revision_number_mismatch",
      "steps": [
        {"op": "begin_work"},
        {"op": "record_revision", "revision": 2, "expect": "revision_number_mismatch"}
      ]
    },
    {
      "name": "manifest_hash_mismatch_revision",
      "steps": [
        {"op": "begin_work"},
        {"op": "record_revision", "manifestHash": "wrong", "expect": "manifest_hash_mismatch"}
      ]
    },
    {
