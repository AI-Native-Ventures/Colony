        {"op": "begin_work"},
        {"op": "record_revision"},
        {"op": "record_qa"},
        {"op": "mark_ready"},
        {"op": "decide", "kind": "approve", "actor": "owner", "expect": "applied", "status": "approved", "activeApproval": true, "count": 1},
        {"op": "decide", "kind": "requestChanges", "actor": "coordinator", "expect": "applied", "status": "changesRequested", "activeApproval": false, "count": 2}
      ]
    },
    {
      "name": "duplicate_decision",
      "steps": [
        {"op": "begin_work"},
        {"op": "record_revision"},
        {"op": "record_qa"},
        {"op": "mark_ready"},
        {"op": "decide", "kind": "approve", "actor": "owner", "expect": "applied"},
        {"op": "decide", "kind": "approve", "actor": "owner", "expect": "duplicate", "status": "approved", "count": 1}
      ]
    },
