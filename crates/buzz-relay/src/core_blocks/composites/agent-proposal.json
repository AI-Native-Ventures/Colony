    {
      "name": "Update researcher",
      "data": {
        "mode": "update",
        "requestId": "5b0907aa-aa18-4db7-b721-04c90492b9e0",
        "channelId": "7c07e659-3610-42f4-9a5e-1e9973c09da9",
        "agentName": "Researcher",
        "systemPrompt": "Qualify matching US businesses and preserve source evidence."
      }
    }
  ],
  "validation": { "state": "tested", "requires_attention": true }
}
