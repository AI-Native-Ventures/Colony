{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "artifact",
  "version": "1.4.0",
  "created_at": 1789531200,
  "name": "Artifact",
  "description": "A delivered website, image, video, document, or file.",
  "origin": "core",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "description",
      "url",
      "alt",
      "status"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "description": {
        "type": "string",
        "maxLength": 2000
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "alt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "preview_html": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "website_bundle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sha256"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "previous_artifact": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "ready-for-review",
          "approved",
          "superseded"
        ]
      }
    }
  },
  "tree": {
    "type": "card",
    "title": "{{title}}",
    "description": "{{description}}",
    "children": [
      {
        "type": "media",
        "url_path": "/url",
        "alt": "{{alt}}"
      },
      {
        "type": "status",
        "label": "Artifact",
        "state_path": "/status"
      },
      {
        "type": "actions",
        "controls": [
          {
            "label": "Approve this design",
            "interaction": {
              "type": "signed",
              "action_id": "artifact.approve-design",
              "resolves_attention": true
            }
          },
          {
            "label": "Download",
            "interaction": {
              "type": "signed",
              "action_id": "artifact.download",
              "resolves_attention": false
            }
          }
        ]
      }
    ],
    "eyebrow": "Your files"
  },
  "actions": [
    {
      "id": "artifact.download",
      "label": "Download",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false
      },
      "interaction": {
        "type": "signed",
        "action_id": "artifact.download",
        "resolves_attention": false
      },
      "permissions": []
    },
    {
      "id": "artifact.approve-design",
      "label": "Approve this design",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "revision",
          "manifest_sha256"
        ],
        "properties": {
          "scope": {
            "const": "design-only",
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "interaction": {
        "type": "signed",
        "action_id": "artifact.approve-design",
        "resolves_attention": true
      },
      "permissions": []
    }
  ],
  "permissions": [],
  "fallback_template": "**{{title}}** \u2014 {{status}}\n{{description}}\n[{{alt}}]({{url}})",
  "supported_clients": [
    "desktop"
  ],
  "primitive_versions": {
    "card": 1,
    "media": 1,
    "status": 1,
    "actions": 1
  },
  "examples": [
    {
      "name": "Website preview",
      "data": {
        "title": "Tennant Group website",
        "description": "Premium responsive homepage ready for review.",
        "url": "https://example.com/tennant-preview.png",
        "alt": "Desktop and mobile homepage preview",
        "status": "ready-for-review"
      }
    }
  ],
  "validation": {
    "state": "tested",
    "requires_attention": false
  }
}
