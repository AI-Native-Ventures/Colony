{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "company-blueprint",
  "version": "1.0.0",
  "created_at": 1785369600,
  "name": "Company Blueprint",
  "description": "The proposed company: who it hires, what teams they sit in, where costs land, and the first three pieces of work. Nothing is created until it is approved.",
  "origin": "core",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "request_id",
      "blueprint_hash",
      "company_id",
      "trading_name",
      "summary",
      "roster",
      "teams",
      "initiatives",
      "gaps",
      "blueprint"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "description": "Ties this proposal to the approval that executes it."
      },
      "blueprint_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Hash of the exact document under review. Approving a different one is refused."
      },
      "company_id": {
        "type": "string",
        "maxLength": 120
      },
      "trading_name": {
        "type": "string",
        "maxLength": 200
      },
      "summary": {
        "type": "string",
        "maxLength": 4000
      },
      "roster": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role_id",
            "role_title",
            "personal_name",
            "team",
            "enabled"
          ],
          "properties": {
            "role_id": {
              "type": "string",
              "maxLength": 80,
              "description": "A role from the trusted catalog. Anything else is refused at execution."
            },
            "role_title": {
              "type": "string",
              "maxLength": 120
            },
            "personal_name": {
              "type": "string",
              "maxLength": 120
            },
            "team": {
              "type": "string",
              "maxLength": 120
            },
            "why": {
              "type": "string",
              "maxLength": 500
            },
            "enabled": {
              "type": "boolean",
              "description": "Unchecking removes this employee from what gets created."
            }
          }
        }
      },
      "teams": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "lead",
            "members",
            "accountable_for"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 120
            },
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "lead": {
              "type": "string",
              "maxLength": 120
            },
            "members": {
              "type": "string",
              "maxLength": 600
            },
            "accountable_for": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      },
      "cost_centres": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "kind": {
              "type": "string",
              "maxLength": 60
            },
            "covers": {
              "type": "string",
              "maxLength": 400
            }
          }
        }
      },
      "initiatives": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "owner",
            "why_first"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "owner": {
              "type": "string",
              "maxLength": 120
            },
            "why_first": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      },
      "gaps": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "cost_of_leaving_open"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 160
            },
            "cost_of_leaving_open": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      },
      "blueprint": {
        "type": "string",
        "maxLength": 60000,
        "description": "The exact executable blueprint this proposal renders. Approving sends this document, and its hash must match blueprint_hash."
      }
    }
  },
  "tree": {
    "type": "stack",
    "gap": "medium",
    "children": [
      {
        "type": "section",
        "title": "{{trading_name}}",
        "text": "{{summary}}"
      },
      {
        "type": "section",
        "title": "The people",
        "text": "Uncheck anyone you don't want. Nothing is created until you approve."
      },
      {
        "type": "table",
        "columns": [
          {
            "key": "personal_name",
            "label": "Name"
          },
          {
            "key": "role_title",
            "label": "Role"
          },
          {
            "key": "team",
            "label": "Team"
          },
          {
            "key": "why",
            "label": "Why"
          },
          {
            "key": "enabled",
            "label": "Create"
          }
        ],
        "rows_path": "/roster"
      },
      {
        "type": "section",
        "title": "The teams"
      },
      {
        "type": "table",
        "columns": [
          {
            "key": "name",
            "label": "Team"
          },
          {
            "key": "lead",
            "label": "Lead"
          },
          {
            "key": "members",
            "label": "Members"
          },
          {
            "key": "accountable_for",
            "label": "Accountable for"
          }
        ],
        "rows_path": "/teams"
      },
      {
        "type": "section",
        "title": "Where costs land"
      },
      {
        "type": "table",
        "columns": [
          {
            "key": "name",
            "label": "Cost centre"
          },
          {
            "key": "kind",
            "label": "Kind"
          },
          {
            "key": "covers",
            "label": "Covers"
          }
        ],
        "rows_path": "/cost_centres"
      },
      {
        "type": "section",
        "title": "First three pieces of work",
        "text": "Proposed only. None of these start until you say so."
      },
      {
        "type": "table",
        "columns": [
          {
            "key": "title",
            "label": "Initiative"
          },
          {
            "key": "owner",
            "label": "Owner"
          },
          {
            "key": "why_first",
            "label": "Why first"
          }
        ],
        "rows_path": "/initiatives"
      },
      {
        "type": "section",
        "title": "Still unknown",
        "text": "These were not answered. The company can start without them, at the cost shown."
      },
      {
        "type": "table",
        "columns": [
          {
            "key": "label",
            "label": "Gap"
          },
          {
            "key": "cost_of_leaving_open",
            "label": "What it costs to leave open"
          }
        ],
        "rows_path": "/gaps"
      },
      {
        "type": "actions",
        "controls": [
          {
            "label": "Approve and create the company",
            "interaction": {
              "type": "signed",
              "action_id": "company-blueprint.approve",
              "resolves_attention": true
            }
          }
        ]
      },
      {
        "type": "section",
        "title": "Not right yet?",
        "text": "Say what to change instead of approving. Whoever drafted this gets your words exactly as you write them, and nothing is created until you approve."
      },
      {
        "type": "question",
        "prompt": "What needs to change?",
        "mode": "multi-select",
        "options": [
          {
            "id": "people",
            "label": "The people",
            "description": "Wrong roles, too many, or someone missing."
          },
          {
            "id": "teams",
            "label": "The teams",
            "description": "The teams do not match how the business actually works."
          },
          {
            "id": "work",
            "label": "The first pieces of work",
            "description": "These are not what the business should start on."
          },
          {
            "id": "facts",
            "label": "The facts about the business",
            "description": "Something written here about the business is wrong."
          }
        ],
        "min_selections": 0,
        "max_selections": 4,
        "allow_custom": true,
        "require_custom_input": true,
        "submit_action": "company-blueprint.revise"
      }
    ]
  },
  "actions": [
    {
      "id": "company-blueprint.approve",
      "label": "Approve and create the company",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "blueprint_hash"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 64
          },
          "blueprint_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Must match the document shown. An edited blueprint is refused rather than executed."
          },
          "disabled_role_ids": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "description": "Roles unchecked during review. These are not created."
          }
        }
      },
      "interaction": {
        "type": "signed",
        "action_id": "company-blueprint.approve",
        "resolves_attention": true
      },
      "permissions": [
        "company.create"
      ]
    },
    {
      "id": "company-blueprint.revise",
      "label": "Ask for changes",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selected",
          "custom_input"
        ],
        "properties": {
          "selected": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "description": "The areas ticked on the card. It may be empty; the written answer is what carries the request.",
            "items": {
              "type": "string",
              "enum": [
                "people",
                "teams",
                "work",
                "facts"
              ]
            }
          },
          "custom_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What to change, in the owner's own words. Required, because a request for changes that does not say what to change is a rejection with extra steps."
          }
        }
      },
      "interaction": {
        "type": "signed",
        "action_id": "company-blueprint.revise",
        "resolves_attention": true
      },
      "permissions": []
    }
  ],
  "permissions": [
    {
      "capability": "company.create",
      "constraints": {
        "exact_content": true,
        "expires": true
      }
    }
  ],
  "fallback_template": "## {{trading_name}}\n\n{{summary}}\n\nPeople:\n{{roster}}\n\nTeams:\n{{teams}}\n\nFirst three pieces of work:\n{{initiatives}}\n\nStill unknown:\n{{gaps}}\n\nApprove to create the company. Nothing exists until you do.",
  "supported_clients": [
    "desktop"
  ],
  "primitive_versions": {
    "section": 1,
    "table": 1,
    "actions": 1,
    "question": 1
  },
