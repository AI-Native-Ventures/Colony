{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "details",
  "version": "1.1.0",
  "created_at": 1785369601,
  "name": "Details",
  "description": "A bounded list of readable label/value facts, with optional date and yes/no formatting.",
  "origin": "core",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string",
        "maxLength": 120
      },
      "value": {
        "type": "string",
        "maxLength": 500
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "value": {
              "type": "string",
              "maxLength": 2000
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "date",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "anyOf": [
      {
        "required": [
          "items"
        ]
      },
      {
        "required": [
          "label",
          "value"
        ]
      }
    ]
  },
  "tree": {
    "type": "details",
    "items": [
      {
        "label": "{{label}}",
        "value": "{{value}}"
      }
    ],
    "items_path": "/items"
  },
  "actions": [],
  "permissions": [],
  "fallback_template": "Details\n{{items}}\n{{label}} {{value}}",
  "supported_clients": [
    "desktop"
  ],
  "primitive_versions": {
    "details": 1
  },
  "examples": [
    {
      "name": "Campaign facts",
      "data": {
        "items": [
          {
            "label": "Owner",
            "value": "Mo · Content & Campaign Specialist"
          },
          {
            "label": "Client",
            "value": "Horizon Labs"
          },
          {
            "label": "Deliverable",
            "value": "September launch campaign"
          },
          {
            "label": "Includes",
            "value": "1 carousel · 2 short videos · 3 captions"
          },
          {
            "label": "Status",
            "value": "Ready for your review"
          }
        ]
      }
    },
    {
      "name": "Owner",
      "data": {
        "label": "Owner",
        "value": "Jordan Lee"
      }
    }
  ],
  "validation": {
    "state": "tested",
    "requires_attention": false
  }
}
