{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "media",
  "version": "1.1.0",
  "created_at": 1788973902,
  "name": "Media",
  "description": "Read-only images, carousels, SVG, video, audio, spreadsheets and PDF previews with original downloads.",
  "origin": "core",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "alt"
    ],
    "oneOf": [
      {
        "required": [
          "url"
        ]
      },
      {
        "required": [
          "items"
        ]
      }
    ],
    "properties": {
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "alt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "filename": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "mime": {
        "type": "string",
        "maxLength": 100
      },
      "poster": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "height": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "size": {
        "type": "number",
        "minimum": 0
      },
      "durationSeconds": {
        "type": "number",
        "minimum": 0
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "mime": {
                  "type": "string",
                  "maxLength": 100
                },
                "poster": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "size": {
                  "type": "number",
                  "minimum": 0
                },
                "durationSeconds": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    }
  },
  "tree": {
    "type": "media",
    "url_path": "/",
    "alt": "{{alt}}"
  },
  "actions": [],
  "permissions": [],
  "fallback_template": "{{alt}}\n{{url}}\n{{items}}",
  "supported_clients": [
    "desktop"
  ],
  "primitive_versions": {
    "media": 1
  },
  "examples": [
    {
      "name": "Website preview",
      "data": {
        "url": "https://example.com/preview.png",
        "alt": "Premium website hero preview"
      }
    },
    {
      "name": "A three-slide campaign",
      "data": {
        "alt": "Launch campaign",
        "items": [
          {
            "url": "https://example.com/slide-1.svg",
            "filename": "slide-1.svg",
            "alt": "Introduce the idea"
          },
          {
            "url": "https://example.com/slide-2.svg",
            "filename": "slide-2.svg",
            "alt": "Show the outcome"
          },
          {
            "url": "https://example.com/slide-3.svg",
            "filename": "slide-3.svg",
            "alt": "Invite a conversation"
          }
        ]
      }
    }
  ],
  "validation": {
    "state": "tested",
    "requires_attention": false
  }
}
