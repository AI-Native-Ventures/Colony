{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "media",
  "version": "1.0.0",
  "created_at": 1785369600,
  "name": "Media",
  "description": "An image, video, file, document, or external preview.",
  "origin": "core",
  "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["url", "alt"],
    "properties": {
      "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
      "alt": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "tree": {
    "type": "media",
    "url_path": "/url",
    "alt": "{{alt}}"
  },
  "actions": [],
  "permissions": [],
  "fallback_template": "[{{alt}}]({{url}})",
  "supported_clients": ["desktop"],
  "primitive_versions": { "media": 1 },
  "examples": [
    {
      "name": "Website preview",
      "data": {
        "url": "https://example.com/preview.png",
        "alt": "Premium website hero preview"
      }
    }
  ],
  "validation": { "state": "tested", "requires_attention": false }
}
