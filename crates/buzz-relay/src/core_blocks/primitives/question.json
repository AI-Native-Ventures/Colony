{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "question",
  "version": "2.0.0",
  "created_at": 1785369601,
  "name": "Question",
  "description": "A question with described choices, single or multiple selection, and optional written input.",
  "origin": "core",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt",
      "choices"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "mode": {
        "type": "string",
        "enum": [
          "single-select",
          "multi-select"
        ],
        "default": "multi-select"
      },
      "choices": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    }
  },
  "tree": {
    "type": "question",
    "prompt": "{{prompt}}",
    "mode": "multi-select",
    "min_selections": 1,
    "max_selections": 12,
    "allow_custom": true,
    "require_custom_input": false,
    "submit_action": "question.submit",
    "mode_path": "/mode",
    "options_path": "/choices"
  },
  "actions": [
    {
      "id": "question.submit",
      "label": "Submit",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selected"
        ],
        "properties": {
          "selected": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "custom_input": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "interaction": {
        "type": "signed",
        "action_id": "question.submit",
        "resolves_attention": false
      },
      "permissions": []
    }
  ],
  "permissions": [],
  "fallback_template": "{{prompt}}\n\nChoices: {{choices}}\nReply with your choice or additional context.",
  "supported_clients": [
    "desktop"
  ],
  "primitive_versions": {
    "question": 1
  },
  "examples": [
    {
      "name": "Choose the launch direction",
      "data": {
        "prompt": "Which direction should lead the launch?",
        "mode": "single-select",
        "choices": [
          {
            "id": "client-story",
            "label": "A client story",
            "description": "Show a brief becoming a finished project."
          },
          {
            "id": "practical-guide",
            "label": "A practical guide",
            "description": "Share three ways to make reviewing work easier."
          },
          {
            "id": "founder-note",
            "label": "A founder note",
            "description": "Explain why we built Colony for service businesses."
          }
        ]
      }
    },
    {
      "name": "Combine useful ideas",
      "data": {
        "prompt": "Which ideas belong in next week’s campaign?",
        "mode": "multi-select",
        "choices": [
          {
            "id": "client-story",
            "label": "A client story",
            "description": "Show a brief becoming a finished project."
          },
          {
            "id": "practical-guide",
            "label": "A practical guide",
            "description": "Share three ways to make reviewing work easier."
          },
          {
            "id": "founder-note",
            "label": "A founder note",
            "description": "Explain why we built Colony for service businesses."
          }
        ]
      }
    }
  ],
  "validation": {
    "state": "tested",
    "requires_attention": false
  }
}
