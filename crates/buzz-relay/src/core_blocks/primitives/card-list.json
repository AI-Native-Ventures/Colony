{
  "schema": "ai-native-office.block-manifest/1",
  "handle": "card-list",
  "version": "1.0.0",
  "created_at": 1785369600,
  "name": "Card List",
  "description": "A collection of structured cards.",
  "origin": "core",
  "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "maxLength": 160 },
            "description": { "type": "string", "maxLength": 500 }
          }
        }
      }
    }
  },
  "tree": {
    "type": "card-list",
    "items_path": "/items",
    "card": {
      "type": "card",
      "title": "{{title}}",
      "description": "{{description}}",
      "children": []
    }
  },
  "actions": [],
  "permissions": [],
  "fallback_template": "{{items}}",
  "supported_clients": ["desktop"],
  "primitive_versions": { "card-list": 1, "card": 1 },
  "examples": [
    {
      "name": "Shortlist",
      "data": {
        "items": [
          { "title": "Northstar Dental", "description": "Strong fit" },
          { "title": "Atlas Fabrication", "description": "Good timing" }
        ]
      }
    }
  ],
  "validation": { "state": "tested", "requires_attention": false }
}
